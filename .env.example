# Copie este archivo a .env y complete los valores. NUNCA suba .env a un repositorio.
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hospital_ods3
DB_USER=app_hospital
DB_PASSWORD=cambie_esta_clave
# Zona horaria de las columnas timestamp de la BD (Colombia = -05:00)
DB_TIMEZONE=-05:00
# Unico origen autorizado para llamar a la API desde un navegador
CORS_ORIGIN=http://localhost:3000
# true para ver en consola el SQL que genera el ORM (util para el video)
SQL_LOG=false
